{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectlumina.org/standards/business-operation-result-schema-v1.json",
  "schema_version": "1.0.0",
  "last_updated": "2026-07-24",
  "title": "Business Operation Result Schema V1",
  "description": "Canonical provider-neutral result envelope for business-system operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "result_id",
    "action_class",
    "capability_namespace",
    "status",
    "occurred_utc"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "result_id": {"type": "string", "minLength": 1},
    "action_class": {"$ref": "business-operation-result-schema-v1.json#/$defs/action_class"},
    "capability_namespace": {"$ref": "business-operation-result-schema-v1.json#/$defs/capability_namespace"},
    "status": {
      "type": "string",
      "enum": ["accepted", "rejected", "pending", "completed", "failed", "cancelled"]
    },
    "occurred_utc": {"type": "string", "format": "date-time"},
    "target_reference": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "external-system-reference-schema-v1.json"}
      ]
    },
    "result_data": {"$ref": "business-operation-result-schema-v1.json#/$defs/safe_object"},
    "errors": {
      "type": "array",
      "items": {"$ref": "connector-error-schema-v1.json"}
    },
    "metadata": {"$ref": "business-operation-result-schema-v1.json#/$defs/safe_object"}
  },
  "$defs": {
    "action_class": {
      "type": "string",
      "enum": [
        "query",
        "create_draft",
        "update_draft",
        "request_commit",
        "request_cancel",
        "sync_event"
      ]
    },
    "capability_namespace": {
      "type": "string",
      "enum": [
        "party/customer",
        "catalog/item",
        "inventory",
        "sales/pos",
        "purchasing",
        "service/work-order",
        "scheduling",
        "timekeeping",
        "accounting/invoice",
        "farm/poultry",
        "farm/beef-cattle",
        "processing/meat",
        "kitchen/production",
        "warehouse/storage",
        "logistics/fleet",
        "logistics/dispatch",
        "logistics/towing",
        "logistics/delivery",
        "logistics/route-zone"
      ]
    },
    "safe_value": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {
          "type": "array",
          "items": {
            "$ref": "business-operation-result-schema-v1.json#/$defs/safe_value"
          }
        },
        {
          "$ref": "business-operation-result-schema-v1.json#/$defs/safe_object"
        }
      ]
    },
    "safe_object": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "^(api_key|apikey|token|access_token|refresh_token|password|secret|client_secret|private_key|authorization|bearer_token)$"
        }
      },
      "additionalProperties": {
        "$ref": "business-operation-result-schema-v1.json#/$defs/safe_value"
      }
    }
  }
}
