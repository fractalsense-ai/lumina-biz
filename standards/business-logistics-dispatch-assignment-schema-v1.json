{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectlumina.org/standards/business-logistics-dispatch-assignment-schema-v1.json",
  "schema_version": "1.0.0",
  "last_updated": "2026-07-24",
  "title": "Business Logistics Dispatch Assignment Schema V1",
  "description": "Canonical provider-neutral dispatch assignment for delivery, dispatch, and towing operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_id",
    "capability_namespace",
    "assignment_status",
    "trip_id",
    "route_zone_id",
    "primary_asset",
    "shipment_ids",
    "assigned_utc"
  ],
  "properties": {
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_namespace": {
      "type": "string",
      "enum": [
        "logistics/dispatch",
        "logistics/towing",
        "logistics/delivery"
      ]
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "proposed",
        "assigned",
        "accepted",
        "in_progress",
        "completed",
        "reassigned",
        "cancelled"
      ]
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "route_zone_id": {
      "type": "string",
      "minLength": 1
    },
    "primary_asset": {
      "$ref": "business-logistics-asset-schema-v1.json"
    },
    "supporting_assets": {
      "type": "array",
      "items": {
        "$ref": "business-logistics-asset-schema-v1.json"
      }
    },
    "shipment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assigned_utc": {
      "type": "string",
      "format": "date-time"
    },
    "completed_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "reassignment_reason": {
      "type": ["string", "null"],
      "maxLength": 2048
    },
    "dispatch_constraints": {
      "$ref": "business-logistics-dispatch-assignment-schema-v1.json#/$defs/safe_object"
    },
    "metadata": {
      "$ref": "business-logistics-dispatch-assignment-schema-v1.json#/$defs/safe_object"
    }
  },
  "$defs": {
    "safe_object": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "^(api_key|apikey|token|access_token|refresh_token|password|secret|client_secret|private_key|authorization|bearer_token)$"
        }
      },
      "additionalProperties": true
    }
  }
}
